POST /wazuh-alerts-4.x-*/_search
{
  "size":0,
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "rule.groups": "tcprecon"
          }
        }
      ]
    }
  },
  "aggs": {
    "event_over_time": {
      "date_histogram": {
        "field": "timestamp",
        "calendar_interval": "1d",
        "min_doc_count": 0
      },
      "aggs": {
        "by_event_type": {
          "terms": {
            "field": "data.event_type",
            "size": 5,
            "include": [
              "service.opened",
              "service.closed",
              "service.reopened",
              "service.changed"
            ]
          }
        }
      }
    }
  }
}
